# Version control
.git
.gitignore

# Python virtual environments and caches
.venv
__pycache__
**/__pycache__/
*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# Node
node_modules
**/node_modules/
**/dist/
**/.vite/

# IDE / editor
.vscode
.idea
*.swp

# Build artifacts that should not leak into the image
tmp/
.agents/
.workspace/
.zest_hook/
code_index/
code_wiki/
wiki_md/

# Misc project files not needed at runtime
docs/
*.md
!zest-app-server/README.md
!zest-agent-server/zest-sdk/README.md
!zest-agent-server/zest-tools/README.md
!zest-common/README.md
LICENSE
NOTICE.md
CHANGELOG.md
docker-compose.yml
Makefile
scripts/
.github/

# Environment files — never bake secrets into images
.env
.env.*
**/.env
**/.env.*

# Lockfile-ish that changes per-platform; keep uv.lock and pnpm-lock.yaml
*.log
dump.rdb
