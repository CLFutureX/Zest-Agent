# ===== Zest-Agent root .env.example =====
# Copy to `.env` and adjust. Loaded by docker-compose.yml and root-level scripts.

# ---- MySQL (default storage backend) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=zest_agent

# ---- Redis (service registry & heartbeat) ----
# Required only when both app-server and agent-server use REGISTRY_MODE/ZEST_REGISTRY_BACKEND=redis.
# For single-machine local mode, set REGISTRY_MODE=local (app-server) and
# ZEST_REGISTRY_BACKEND=local (agent-server); both must share REGISTRY_DIR.
REDIS_URL=redis://localhost:6379/0

# ---- Security ----
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZEST_SECRET_KEY=change-me-in-production

# ---- LLM (zest-sdk uses litellm) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Logging ----
LOG_LEVEL=INFO