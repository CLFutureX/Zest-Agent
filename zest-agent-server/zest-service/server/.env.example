# ===== zest-service .env.example =====
# Copy to `zest-agent-server/zest-service/server/.env`. Loaded by server/config.py (prefix ZEST).

# ---- Runtime identity ----
ZEST_AGENT_SERVER_HOST=0.0.0.0
ZEST_AGENT_SERVER_PORT=8001

# ---- Registry heartbeat ----
# ZEST_REGISTRY_BACKEND: redis (default) or local (single-machine file-based, no Redis)
# When ZEST_REGISTRY_BACKEND=local, ZEST_REGISTRY_DIR must point to the same physical
# directory as the app-server's REGISTRY_DIR.
ZEST_REGISTRY_ENABLED=true
ZEST_REGISTRY_BACKEND=redis
ZEST_REGISTRY_REDIS_URL=redis://localhost:6379/0
ZEST_REGISTRY_KEY_PREFIX=agent_registry
ZEST_HEARTBEAT_INTERVAL=10
ZEST_HEARTBEAT_TIMEOUT=30
ZEST_REGISTRY_DIR=.runtime/registry/servers

# ---- Security ----
ZEST_SECRET_KEY=change-me-in-production

# ---- Optional (uncomment to override defaults) ----
# ZEST_SESSION_API_KEYS=
# ZEST_ALLOW_CORS_ORIGINS=[]
# ZEST_ENABLE_VSCODE=true
# ZEST_VSCODE_PORT=8001
# ZEST_ENABLE_VNC=false
# ZEST_PRELOAD_TOOLS=true
# ZEST_PUBLIC_API_BASE=http://host:8000/api
# ZEST_PUBLIC_WEBSOCKET_BASE=ws://host:8000/sockets