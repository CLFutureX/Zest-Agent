{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server: AppServer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/main.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        },
        {
            "name": "Client: Agent 1",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/example/agentserver_client.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "AGENT_ID": "agent-001"
            },
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        },
        {
            "name": "Client: Agent 2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/example/agentserver_client.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "AGENT_ID": "agent-002"
            },
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        }
    ]
}