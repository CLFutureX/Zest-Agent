# ===== zest-app-server .env.example =====
# Copy to `zest-app-server/.env`. Loaded by app/config/settings.py.

# ---- App ----
APP_NAME=zest-agent-appserver
HOST=0.0.0.0
PORT=9000
DEBUG=true
WORKERS=1

# ---- Storage (mysql | local) ----
STORAGE_MODE=mysql
MYSQL_URL=mysql+aiomysql://root:root@localhost:3306/zest_agent
LOCAL_DATA_DIR=./.data

# ---- Registry ----
# REGISTRY_MODE: redis (default) or local (single-machine file-based, no Redis)
# When REGISTRY_MODE=local, REGISTRY_DIR must point to a path shared with the agent-server.
REGISTRY_MODE=redis
REDIS_URL=redis://localhost:6379/0
REGISTRY_KEY_PREFIX=agent_registry
HEARTBEAT_INTERVAL=10
HEARTBEAT_TIMEOUT=30
REGISTRY_WATCH_INTERVAL=5
REGISTRY_DIR=.runtime/registry/servers

# ---- Local-mode registry (only used when REGISTRY_MODE=local) ----
# Both app-server and agent-server must point REGISTRY_DIR at the SAME physical directory.
# REGISTRY_MODE=local
# REGISTRY_DIR=.runtime/registry/servers

# ---- Load balancing ----
LB_STRATEGY=session_affinity
HEALTH_CHECK_INTERVAL=10

# ---- Agent runtime connection ----
AGENT_SERVICE_SCHEME=http
AGENT_SERVICE_WS_SCHEME=ws
AGENT_SERVICE_API_PREFIX=/api
AGENT_SERVICE_SESSION_API_KEY=

# ---- Security ----
ZEST_SECRET_KEY=change-me-in-production

# ---- Logging ----
LOG_LEVEL=DEBUG
LOG_FILE=.data/logs/appserver.log