# syntax=docker/dockerfile:1.7
#
# Zest-Agent zest-web image
# Build static assets with Vite, serve with nginx.
#
# Build context: repository root
#   docker build -t zest-web:latest -f docker/Dockerfile.web .
#

########################################
# Stage 1: build static assets
########################################
FROM node:20-alpine AS builder

WORKDIR /app

# Enable pnpm via corepack
ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9 --activate

# Cache deps first
COPY zest-web/package.json zest-web/pnpm-lock.yaml ./zest-web/
WORKDIR /app/zest-web
RUN pnpm install --frozen-lockfile

# Copy source and build
WORKDIR /app
COPY zest-web/ ./zest-web/
WORKDIR /app/zest-web
# Build-time env: points API base at the browser-facing host.
# Override with --build-arg if needed.
ARG VITE_APP_API_BASE=http://127.0.0.1:9000/api/v1
ENV VITE_APP_API_BASE=$VITE_APP_API_BASE
RUN pnpm build

########################################
# Stage 2: nginx serves the static bundle
########################################
FROM nginx:1.27-alpine AS runtime

# SPA fallback to index.html + reverse-proxy /api and /ws to zest-app-server.
RUN { \
      echo 'server {'; \
      echo '  listen 80;'; \
      echo '  server_name _;'; \
      echo '  root /usr/share/nginx/html;'; \
      echo '  index index.html;'; \
      echo '  location / { try_files $uri /index.html; }'; \
      echo '  location /api/ { proxy_pass http://zest-app-server:9000; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }'; \
      echo '  location /ws/ { proxy_pass http://zest-app-server:9000; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_read_timeout 86400; }'; \
      echo '}'; \
    } > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/zest-web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ || exit 1
